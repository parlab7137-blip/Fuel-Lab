# Copy to .env for local runs. On Vercel these are set in Project -> Settings -> Environment Variables.
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Local SQLite file (default ./data/fuellab.db):
# DATABASE_PATH=./data/fuellab.db
# Turso (production):
# TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Local test account (local database only): dev@fuellab.test / fuellab-dev-pass
